# ========================================================
# MobiVerse India - Server Environment Configuration
# ========================================================

# Application Mode & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local, fallback to in-memory in dev if empty)
MONGODB_URI=mongodb://localhost:27017/mobiverse_india

# JWT Secrets (use high-entropy secrets in production)
JWT_SECRET=super_secret_jwt_access_key_change_in_production_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_67890
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Configuration (Use TEST keys in development)
# Get keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Price Sync Job & Data Source Configuration
# Options: mock_feed | admin_csv | licensed_api | provider_entered
PRICE_SYNC_DATA_SOURCE=mock_feed
PRICE_SYNC_CRON="0 */4 * * *"

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
